# ==============================================================================
# PETCONNECT AI ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Django App Settings
SECRET_KEY=YOUR_DJANGO_SECRET_KEY_HERE
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.petconnect.ai

# Database Settings (PostgreSQL 16)
POSTGRES_DB=petconnect_db
POSTGRES_USER=petconnect_admin
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Settings (Cache & Celery Broker)
REDIS_URL=redis://redis:6379/0

# AI Provider Credentials (Google Gemini & OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Push Notifications (Firebase FCM)
FCM_CREDENTIALS_PATH=/app/config/firebase-service-account.json

# Object Storage Credentials (AWS S3 / MinIO)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=petconnect-media-prod
AWS_S3_REGION=us-east-1

# Email Credentials (SendGrid / SMTP)
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=no-reply@petconnect.ai
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD

# MQTT IoT Broker Settings (EMQX / Mosquitto)
MQTT_BROKER_HOST=mqtt.petconnect.ai
MQTT_BROKER_PORT=8883
MQTT_TLS_ENABLED=true
